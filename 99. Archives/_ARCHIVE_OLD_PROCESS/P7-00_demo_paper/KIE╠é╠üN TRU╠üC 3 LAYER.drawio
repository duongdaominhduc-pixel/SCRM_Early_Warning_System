        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\ntitle: SCRM-EWS Pipeline Architecture\n---\nflowchart TD\n    subgraph PHASE0[\&quot;PHASE 0 · Thu thập &amp; Gán nhãn (P3-01/02)\&quot;]\n        direction TB\n        A1[\&quot;🌐 Khai thác tin tức\\n2.554 bài báo\\ntiếng Anh\&quot;]\n        A2[\&quot;🧹 Tiền xử lý văn bản\\nHTTP→text, dedup,\\nnormalize unicode\&quot;]\n        A3[\&quot;🏷️ Gán nhãn thủ công\\n700 bài × 3 nhãn\\nSafe/LowRisk/HighRisk\\nFleiss κ ≥ 0.70\&quot;]\n        A4[\&quot;📊 Phân loại loại\\ngián đoạn (rule-based)\\n6 danh mục\\n(PORT/LABOR/...)\&quot;]\n        A1 --&gt; A2 --&gt; A3\n        A2 --&gt; A4\n    end\n\n    subgraph PHASE1[\&quot;PHASE 1 · NLP Layer — DistilBERT C1 (P3-03/04)\&quot;]\n        direction TB\n        B1[\&quot;✂️ Tokenize\\ntitle + [SEP] + content\\nMAX_LEN=512\&quot;]\n        B2[\&quot;🤖 DistilBERT\\ndistilbert-base-uncased\\nFine-tune 5 epochs\\nLR=2e-5, BS=16\\nclass_weight=balanced\\nLabel-2 oversample ×5\&quot;]\n        B3[\&quot;📋 Đánh giá\\nChronological 560/70/70\\nMacro-F1 | AUC-ROC\\nConfusion Matrix\&quot;]\n        B4[\&quot;🔍 spaCy NER\\nen_core_web_trf\\nLocation / Org / Date\&quot;]\n        A3 --&gt; B1 --&gt; B2 --&gt; B3\n        B2 --&gt; B4\n    end\n\n    subgraph PHASE2[\&quot;PHASE 2 · Mapping Layer — 3D Soft Join (P4-05)\&quot;]\n        direction TB\n        C1[\&quot;📰 structured_risk_events\\n(event_week, country,\\ndisruption_type, risk_class)\&quot;]\n        C2[\&quot;🏭 parts_master\\n(supplier_id, country,\\npart_family, criticality)\&quot;]\n        C3[\&quot;⚙️ 3D Soft Join\\nT: cửa sổ [week-4, week]\\nG: supplier_country match\\nC: CATEGORY_MAP\\ndisruption→part_family\&quot;]\n        C4[\&quot;📦 matched_events\\nper (part_family × week)\\nnews_risk_score [0,1]\\ndisruption_event_flag {0,1}\\nseverity_score [0,10]\&quot;]\n        B3 --&gt; C1\n        B4 --&gt; C1\n        C1 --&gt; C3\n        C2 --&gt; C3\n        C3 --&gt; C4\n    end\n\n    subgraph PHASE3A[\&quot;PHASE 3A · Operational Features (P4-01…P4-04)\&quot;]\n        direction TB\n        D1[\&quot;📦 purchase_orders\\n29.666 POs\\n55.85% late\&quot;]\n        D2[\&quot;🏪 inventory_levels\\n280.800 bản ghi\\nTTS_days, burn_rate_daily\&quot;]\n        D3[\&quot;⚠️ quality_incidents\\n368 sự cố\&quot;]\n        D4[\&quot;📈 P4-03: Delivery Delays\\navg_delay, pct_late\\nper (supplier × week)\&quot;]\n        D5[\&quot;⏳ P4-02: SWIP\\nTTS_days = on_hand / burn_rate\\nper (part × site × week)\&quot;]\n        D6[\&quot;🔬 P4-04: Stationarity\\nADF + KPSS\\nTTS→Stationary\\navg_delay→Non-stationary\&quot;]\n        D1 --&gt; D4\n        D2 --&gt; D5 --&gt; D6\n        D3 --&gt; D4\n    end\n\n    subgraph PHASE3B[\&quot;PHASE 3B · Feature Matrix &amp; ML (P5-01…P5-14)\&quot;]\n        direction TB\n        E1[\&quot;📊 Feature Matrix\\n1.248 rows × 10 features\\n8 part_family × 156 weeks\\n(P5-01)\&quot;]\n        E2[\&quot;🎯 y_true (P5-02)\\nPhương án A:\\nstockout OR\\n(avg_delay≥3 AND pct_late≥50%)\\n53.5% positive\&quot;]\n        E3[\&quot;🔀 Walk-Forward CV\\n5 folds × 13 weeks\\nExpanding window\\n(P5-06)\&quot;]\n        E4[\&quot;📉 LR Baseline\\nOperational only\\nF1=0.74 | AUC=0.72\\n(P5-07)\&quot;]\n        E5[\&quot;🌲 XGBoost\\n10 features (ops+NLP)\\nF1→? | AUC→?\\n(P5-08)\&quot;]\n        E6[\&quot;📊 SHAP Analysis\\nFeature importance\\nburnrate=0.477\\npct_late=0.240\\n(P5-10)\&quot;]\n        E7[\&quot;📍 Youden&#39;s J\\nOptimal threshold\\n= 0.48 (mock)\\n(P5-11)\&quot;]\n        E8[\&quot;🚨 Weekly Alerts\\nAlert rate: 23.5%\\n(P5-12)\&quot;]\n        E9[\&quot;⏱️ Lead Time\\nof Warning (LTW)\\nmean ≥ 2 weeks target\\n(P5-13)\&quot;]\n        E1 --&gt; E3\n        E2 --&gt; E3\n        E3 --&gt; E4\n        E3 --&gt; E5\n        E5 --&gt; E6\n        E5 --&gt; E7 --&gt; E8 --&gt; E9\n    end\n\n    %% Cross-phase connections\n    D4 --&gt; E1\n    D5 --&gt; E1\n    D3 --&gt; E1\n    C4 --&gt; E1\n\n    %% Styling\n    classDef phase0 fill:#e8f4f8,stroke:#2196F3,color:#000\n    classDef phase1 fill:#fff3e0,stroke:#FF9800,color:#000\n    classDef phase2 fill:#e8f5e9,stroke:#4CAF50,color:#000\n    classDef phase3a fill:#fce4ec,stroke:#E91E63,color:#000\n    classDef phase3b fill:#f3e5f5,stroke:#9C27B0,color:#000\n\n    class A1,A2,A3,A4 phase0\n    class B1,B2,B3,B4 phase1\n    class C1,C2,C3,C4 phase2\n    class D1,D2,D3,D4,D5,D6 phase3a\n    class E1,E2,E3,E4,E5,E6,E7,E8,E9 phase3b&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Iea8GozMdGJ6Ukd1WQ6D-1">
